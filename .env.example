# Isyarat — konfigurasi opsional
# Aplikasi tetap berjalan penuh tanpa file ini (mode lokal / localStorage).

# ---------- Supabase (opsional: login + sinkron profil isyarat) ----------
NEXT_PUBLIC_SUPABASE_URL=
# Pakai publishable key (sb_publishable_...). Nama lama ANON_KEY masih didukung.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy, hanya jika project lama belum punya publishable key

# ---------- LLM untuk merapikan hasil ejaan (opsional) ----------
# Kalau kosong, tombol "Rapikan" akan nonaktif. Tidak wajib.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- Override aset (opsional) ----------
# NEXT_PUBLIC_MEDIAPIPE_WASM=/mediapipe/wasm
# NEXT_PUBLIC_HAND_MODEL=/models/hand_landmarker.task
